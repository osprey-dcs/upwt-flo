record ( ai, "flo2_DAS:sys:das_status") {
    field ( DESC, "TS2: DAS status ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "1" )
}

record ( ai, "flo2_DAS:sys:dasalive") {
    field ( DESC, "TS2: DAS heartbeat ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "1" )
}

record ( ai, "flo2_DAS:sys:ts_alive") {
    field ( DESC, "TS2: DAS test section heartbeat ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "1" )
}

