record ( ai, "floctl:ai:c1_air_inlet") {
    field ( DESC, "Cooler 1 air inlet temperature" )
    field ( SCAN, ".1 second" )
    field ( EGUF, "0.01" )
    field ( EGUL, "-0.01" )
    field ( EGU, "degF" )
