record ( ai, "flo2_DAS:sys:alpha") {
    field ( DESC, "TS2: Model angle of attack ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

