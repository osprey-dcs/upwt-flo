record ( ai, "flo1_DAS:sys:alpha") {
    field ( DESC, "TS1: Model angle of attack ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

