record ( ai, "flo_DAS:sys:curr_das") {
    field ( DESC, "DAS: Current DAS in use ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "1" )
}

record ( ai, "flo_DAS:sys:hour") {
    field ( DESC, "DAS: DAS timestamp - hour ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

record ( ai, "flo_DAS:sys:minute") {
    field ( DESC, "DAS: DAS timestamp - minute ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

record ( ai, "flo_DAS:sys:second") {
    field ( DESC, "DAS: DAS timestamp - second ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

record ( ai, "flo_DAS:sys:temposon") {
    field ( DESC, "DAS: ??" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

record ( ai, "flo_DAS:sys:to") {
    field ( DESC, "Test section temperature - from DAS" )
    field ( SDIS, "0" )
    field ( FLNK, "0" )
    field ( EGU, "volts" )
    field ( PREC, "3" )
}

